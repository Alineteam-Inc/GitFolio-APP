// The web pages' scripts, type-checked as they are (npm run check). Each window loads its own page, whose
// scripts share one global scope as in the browser: the GitFolio window's here, the tray's in
// tsconfig.index.json.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "files": ["globals.d.ts", "src/i18n.js", "src/app.js", "src/manage.js"]
}
