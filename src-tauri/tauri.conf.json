{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitFolio",
  "version": "0.1.0",
  "identifier": "team.aline.gitfolio.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "GitFolio",
        "width": 360,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "manage",
        "create": false,
        "title": "GitFolio",
        "url": "manage.html",
        "width": 720,
        "height": 520,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/gitfolio"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
