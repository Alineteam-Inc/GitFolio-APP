{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitFolio",
  "version": "0.1.0",
  "identifier": "team.aline.gitfolio.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "GitFolio",
        "width": 400,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "manage",
        "create": false,
        "title": "GitFolio",
        "url": "manage.html",
        "width": 720,
        "height": 520,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Alineteam Inc.",
    "copyright": "© 2026 Alineteam Inc.",
    "homepage": "https://aline.team",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Your git history, turned into a verified developer portfolio",
    "externalBin": [
      "binaries/gitfolio"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFQ0RCQkIwQkQ1NTVBNkEKUldScVdsVzlzTHZON3RVVFlGZDQyS1BhcVBmdnZPVTZ5akZTcEVady9Ob2oydHpKMlduREM4MGMK",
      "endpoints": [
        "https://github.com/Alineteam-Inc/GitFolio-GUI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
